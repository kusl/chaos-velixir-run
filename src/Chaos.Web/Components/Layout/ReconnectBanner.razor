<div id="components-reconnect-modal" class="reconnect" role="status" data-nosnippet>
    <p class="when-show">Connection lost. Reconnecting…</p>
    <p class="when-retrying">Waking up the server. Attempt <span id="components-reconnect-current-attempt"></span> of <span id="components-reconnect-max-retries"></span>.</p>
    <p class="when-failed">The server isn't answering. <button type="button" data-reconnect-retry>Try again</button></p>
    <p class="when-paused">This session is paused. <button type="button" data-reconnect-resume>Resume</button></p>
    <p class="when-resume-failed">This session couldn't be resumed. <button type="button" data-reconnect-reload>Reload</button></p>
    <p class="when-rejected">The server restarted. Reloading…</p>
</div>
